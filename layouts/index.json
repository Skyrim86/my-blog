{{- /* 搜索索引 —— 覆盖主题 themes/PaperMod/layouts/index.json。

   与主题原版的三处差异：
   1. content 从「每页 .Plain 全文」改为截断 400 字。主题原版会把 CMC2026 那些长文档
      整篇塞进索引，本站 index.json 因此有 148 KB；截断后约 17 KB。
      **2026-09-25 再收一轮**（余量 6 KB → 15 KB，实测 48.3 → 40.9 KB）：正文 400 → 300 字，
      标题字段一个字没动（长文档的可检索性靠它，见第 4 条）；permalink 从绝对 URL 改成
      .RelPermalink（值可推导、占索引 11.3%，改后 href 照常可用）。改字段前对拍过搜索结果：
      10 个查询在线上（旧索引）与本地（新索引）结果集合逐条相同。
      代价：正文只能匹配每页前 400 字（标题 / 摘要 / 标签仍是全量匹配）。
   2. summary 做 plainify + 截断 150 字。这一条是配合构建期公式渲染的必需处理：
      没有显式写 summary 的页面（课程材料页就是），Hugo 会从 .Content 自动截取，
      而公式现在渲染成了大段 KaTeX 标记，自动摘要会变成 5000+ 字的 HTML（含完整 MathML），
      把索引从 17 KB 撑到 49 KB，检索结果里也会混进标记。plainify 后只剩纯文本。
   3. 新增 tags 字段，让标签也能被搜到（hugo.toml 的 fuseOpts.keys 已同步加上 'tags'）。
   4. 新增 headings 字段（页内各级标题，最多三层拼接）。原因：正文截断到 400 字之后，
      课程笔记 / 项目文档这类长文里的关键词基本搜不到（实测搜「浮点」命中 0 条，而
      chapter-01/notes 里明明有「1.3 浮点数与机器精度」）——标题是信息密度最高、体积
      又最小的部分，补上它长文档才有可检索性（21 页实测：索引 29.3 KB → 39.1 KB）。

   其余逻辑（searchHidden、archives/search 页排除）沿用主题，未改动。
   这是继 layouts/courses/*.html 之后第二处有意的主题模板覆盖：主题该模板没有 hook 可挂，
   而截断逻辑无法从外部配置实现。改索引字段时记得同步 hugo.toml 的 fuseOpts.keys。 */ -}}
{{- $index := slice -}}
{{- range site.RegularPages -}}
    {{- if and (not .Params.searchHidden) (ne .Layout `archives`) (ne .Layout `search`) }}
    {{- /* 页内各级标题（最多三层）也进索引，理由见文件头第 4 条 */ -}}
    {{- $heads := slice -}}
    {{- range .Fragments.Headings -}}
      {{- $heads = $heads | append .Title -}}
      {{- range .Headings -}}
        {{- $heads = $heads | append .Title -}}
        {{- range .Headings -}}{{- $heads = $heads | append .Title -}}{{- end -}}
      {{- end -}}
    {{- end -}}
    {{- $index = $index | append (dict
        "title" .Title
        "content" (.Plain | truncate 300)
        "permalink" .RelPermalink
        "summary" (.Summary | plainify | htmlUnescape | truncate 150)
        "headings" (truncate 400 (delimit $heads " "))
        "tags" (.Params.tags | default slice)) -}}
    {{- end -}}
{{- end -}}
{{- $index | jsonify -}}

